%% NTIS Domain RAG Chatbot — Detailed Conditional Flow (상세 조건별 동작 흐름)
%% 영문 원문(한글설명) 표기. 코드에서 직접 추출한 라우터 함수와 분기 조건.
%% Source files:
%%   apps/pipeline/agent_workflow.py        — 라우터 5종 + 13 conditional edges
%%   apps/pipeline/agents/dialogue_agent.py
%%   apps/pipeline/agents/entity_resolver.py
%%   apps/pipeline/agents/search_planner.py
%%   apps/pipeline/agents/retrieval_agent.py
%%   apps/pipeline/agents/evidence_curator.py
%%   apps/pipeline/agents/answer_agent.py
%%   apps/pipeline/agents/critic_agent.py

flowchart TD
    Client(["Client / UI<br/>(클라이언트)"])

    %% ===== HTTP =====
    subgraph HTTP["FastAPI Layer (HTTP 진입)"]
        Route["POST /query · /query/stream<br/>(routes.py)"]
        BuildState["Build AgentPipelineState<br/>(파이프라인 상태 컨테이너 생성)"]
        Route --> BuildState
    end

    Client -->|HTTP Request| Route

    %% ===== load_session =====
    LoadSession["load_session<br/>(KV 조회: session:{conv_id})<br/>3 slots 복원: Subject · Manifest · FocusedDetail"]
    BuildState --> LoadSession

    %% ===== DialogueAgent =====
    Dialogue["1. DialogueAgent (Solar vLLM)<br/>의도 분류 → DialogueIntent<br/>kind ∈ {ask_search, ask_detail, ask_meta,<br/>ask_children, ask_similar, refine_previous,<br/>compare, stats, direct_answer, clarification}"]
    LoadSession --> Dialogue

    R1{{"route_after_dialogue<br/>(분기 라우터)"}}
    Dialogue --> R1

    R1 -->|"intent is None<br/>(LLM 실패)"| EmitErr1["emit_internal_error<br/>(내부 오류 응답)"]
    R1 -->|"kind == 'direct_answer'<br/>(잡담·즉답 가능)"| EmitDirect["emit_direct_answer<br/>(LLM 직접 답변, 검색 생략)"]
    R1 -->|"kind == 'clarification'<br/>(모호함)"| EmitClar1["emit_clarification<br/>(사용자에게 되묻기)"]
    R1 -->|"else (search·refine·detail·...)"| EntityResolver

    %% ===== EntityResolver =====
    EntityResolver["2. EntityResolverAgent (no LLM)<br/>식별자/필터/주어앵커 결정 → EntityResolution<br/>identifiers: pjt_id, rst_id, pjt_no, person_no, org_id, biz_no<br/>resolution_source: identifier_literal | manifest | focused_detail | ..."]

    R2{{"route_after_entity_resolver"}}
    EntityResolver --> R2

    R2 -->|"resolution is None<br/>(예외)"| EmitErr2["emit_internal_error"]
    R2 -->|"clarification_needed == True<br/>(예: '그 사람' 해소 실패)"| EmitClar2["emit_clarification"]
    R2 -->|"else (정상 해석)"| SearchPlanner

    %% ===== SearchPlanner =====
    SearchPlanner["3. SearchPlannerAgent (deterministic, no LLM)<br/>→ SearchPlan | None<br/>SearchTask.strategy ∈ {exact_lookup, subject_anchor, hybrid_search, aggregate}<br/>merge_strategy ∈ {single, by_score_dedup, by_axis_groupby}"]

    R3{{"route_after_search_planner"}}
    SearchPlanner --> R3

    R3 -->|"plan is None & kind=='ask_meta'<br/>(메타 질문)"| EmitMeta["emit_meta_answer<br/>(시스템 설명 즉답)"]
    R3 -->|"plan is None & kind=='ask_children'<br/>(하위조회·부모ID 없음)"| EmitChildren["emit_children_list<br/>(캐시된 자식 리스트 출력)"]
    R3 -->|"plan is None<br/>(주어·ID·쿼리 모두 없음)"| EmitClar3["emit_clarification<br/>(검색 불가 → 되묻기)"]
    R3 -->|"plan 존재"| Retrieval

    %% ===== RetrievalAgent =====
    Retrieval["4. RetrievalAgent → SearchAgent<br/>SearchTask 병렬 실행 → Qdrant<br/>exact_lookup: retrieve(ids=...)<br/>subject_anchor: filter+hybrid<br/>hybrid_search: dense(E5-Instruct) + sparse<br/>aggregate: scroll(≤1000) → groupby<br/>→ SearchResult.status ∈ {single, multiple, empty, error}"]

    R4{{"route_after_retrieval"}}
    Retrieval --> R4

    R4 -->|"search_result is None<br/>or status == 'error'<br/>(all_tasks_failed / qdrant / timeout)"| EmitErr3["emit_internal_error"]
    R4 -->|"else (single·multiple·empty)"| Curator

    %% ===== EvidenceCurator =====
    Curator["5. EvidenceCuratorAgent (no LLM)<br/>_decide_view() 우선순위:<br/>① status in (empty,error) → view='empty'<br/>② ask_detail / action_hint='detail' → 'single_detail'<br/>③ compare → 'comparison_table'<br/>④ stats → 'stats_summary'<br/>⑤ subject 존재 → 'subject_activity'<br/>⑥ else → 'list_compact'"]

    R4 -.정상.-> Curator

    %% ===== AnswerAgent =====
    Answer["6. AnswerAgent (Gemma Triton · LLM writer)<br/>view → template:<br/>empty→no_result (LLM 미호출)<br/>single_detail→detail · subject_activity/list_compact→list<br/>stats_summary→stats · comparison_table→compare<br/>본문 [N] 인용 파싱 → AnswerDraft.citations"]
    Curator --> Answer

    %% ===== CriticAgent =====
    Critic["7. CriticAgent — 5-stage validation<br/>Stage 0: view=='empty' or template=='no_result' → publish<br/>Stage 1: text 빈 문자열 → internal_error (empty_generation)<br/>Stage 2: 인용 누락 → repair / clarify<br/>Stage 3: 인용 범위 초과 → repair / clarify<br/>Stage 4: not_grounded → repair / publish+warning"]
    Answer --> Critic

    R5{{"route_after_critic"}}
    Critic --> R5

    R5 -->|"decision == 'publish'<br/>(정상)"| SaveSession
    R5 -->|"decision == 'repair_answer'<br/>(repair_attempted=True · 1회 한도)"| Answer
    R5 -->|"decision == 'clarify'<br/>(재시도 후 실패)"| EmitClar4["emit_clarification"]
    R5 -->|"decision == 'internal_error' or None"| EmitErr4["emit_internal_error"]

    %% ===== save_session =====
    SaveSession["save_session<br/>슬롯 갱신 규칙 (view 기반):<br/>SubjectSlot: subject 있으면 갱신<br/>ManifestSlot: single_detail→유지, 그 외→갱신(top 20)<br/>FocusedDetailSlot: single_detail→갱신, 그 외→클리어"]

    EmitDirect --> SaveSession
    EmitClar1 --> SaveSession
    EmitClar2 --> SaveSession
    EmitClar3 --> SaveSession
    EmitClar4 --> SaveSession
    EmitMeta --> SaveSession
    EmitChildren --> SaveSession
    EmitErr1 --> SaveSession
    EmitErr2 --> SaveSession
    EmitErr3 --> SaveSession
    EmitErr4 --> SaveSession

    Response(["HTTP Response<br/>(JSON 또는 SSE 스트림)"])
    SaveSession --> Response
    Response -.응답.-> Client

    %% ===== Infra =====
    Qdrant[("Qdrant Collections<br/>ntis_project_v1<br/>ntis_perf_v1<br/>ntis_supports")]
    KV[("Redis / File KV<br/>session:{conv_id}")]
    Solar["Solar vLLM<br/>(Dialogue)"]
    Gemma["Gemma Triton<br/>(Answer)"]

    Dialogue -.LLM.-> Solar
    Answer -.LLM.-> Gemma
    Retrieval -.search.-> Qdrant
    LoadSession <-.-> KV
    SaveSession <-.-> KV

    %% ===== Styling =====
    classDef agent fill:#1e3a8a,stroke:#60a5fa,color:#fff,stroke-width:1.5px
    classDef agentLLM fill:#6d28d9,stroke:#a78bfa,color:#fff,stroke-width:1.5px
    classDef router fill:#fffbeb,stroke:#f59e0b,color:#92400e,stroke-width:1.5px
    classDef emit fill:#f1f5f9,stroke:#94a3b8,color:#0f172a
    classDef emitOk fill:#dcfce7,stroke:#22c55e,color:#14532d
    classDef emitWarn fill:#fef3c7,stroke:#f59e0b,color:#78350f
    classDef emitErr fill:#fee2e2,stroke:#ef4444,color:#7f1d1d
    classDef infra fill:#064e3b,stroke:#34d399,color:#fff

    class Dialogue,Answer agentLLM
    class EntityResolver,SearchPlanner,Retrieval,Curator,Critic agent
    class R1,R2,R3,R4,R5 router
    class EmitDirect,SaveSession emitOk
    class EmitClar1,EmitClar2,EmitClar3,EmitClar4,EmitMeta,EmitChildren emitWarn
    class EmitErr1,EmitErr2,EmitErr3,EmitErr4 emitErr
    class Qdrant,KV,Solar,Gemma infra
    class LoadSession,BuildState,Route emit
